{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CONTENTFUL_PREVIEW",
        "GRAPHQL_ENDPOINT",
        "PLAYWRIGHT_BASE_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "CONTAINER_APP_ENV",
        "REDIS_HOST",
        "REDIS_PASSWORD",
        "AZURE_AD_B2C_CLIENT_SECRET",
        "PCM_AES_KEY",
        "PCM_HASH_KEY"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "dev": {
      "persistent": true
    }
  }
}
