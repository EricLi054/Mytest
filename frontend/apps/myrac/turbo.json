{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CONTENTFUL_PREVIEW",
        "GRAPHQL_ENDPOINT",
        "PLAYWRIGHT_BASE_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "CONTAINER_APP_ENV",
        "REDIS_HOST",
        "REDIS_PASSWORD",
        "AZURE_AD_B2C_CLIENT_SECRET",
        "PCM_AES_KEY",
        "PCM_HASH_KEY",
        "PLAYWRIGHT_ENV",
        "PLAYWRIGHT_BLUE_MEMBER",
        "PLAYWRIGHT_BLUE_PASSWORD",
        "PLAYWRIGHT_RED_MEMBER",
        "PLAYWRIGHT_RED_PASSWORD",
        "PLAYWRIGHT_BRONZE_MEMBER",
        "PLAYWRIGHT_BRONZE_PASSWORD",
        "PLAYWRIGHT_SILVER_MEMBER",
        "PLAYWRIGHT_SILVER_PASSWORD",
        "PLAYWRIGHT_GOLD_MEMBER",
        "PLAYWRIGHT_GOLD_PASSWORD",
        "PLAYWRIGHT_GOLD_LIFE_MEMBER",
        "PLAYWRIGHT_GOLD_LIFE_PASSWORD",
        "PLAYWRIGHT_STAFF_MEMBER",
        "PLAYWRIGHT_STAFF_PASSWORD",
        "PLAYWRIGHT_FREE2GO_MEMBER",
        "PLAYWRIGHT_FREE2GO_PASSWORD",
        "PLAYWRIGHT_IGNITE_MEMBER",
        "PLAYWRIGHT_IGNITE_PASSWORD",
        "PLAYWRIGHT_SIT_USERNAME",
        "PLAYWRIGHT_SIT_PASSWORD",
        "PLAYWRIGHT_UAT_USERNAME",
        "PLAYWRIGHT_UAT_PASSWORD",
        "ACTIVE_DIGITAL_CARD_MEMBER",
        "ACTIVE_DIGITAL_CARD_PASSWORD",
        "CARD_USER_UAT",
        "CARD_PASSWORD_UAT",
        "PLAYWRIGHT_FIN_LOAN_MEMBER",
        "PLAYWRIGHT_FIN_LOAN_PASSWORD",
        "PLAYWRIGHT_LANDLINE_USER",
        "PLAYWRIGHT_LANDLINE_PASSWORD",
        "PLAYWRIGHT_NO_PHONE_USER",
        "PLAYWRIGHT_NO_PHONE_PASSWORD",
        "PLAYWRIGHT_DEFAULT_USERNAME",
        "PLAYWRIGHT_DEFAULT_PASSWORD",
        "PLAYWRIGHT_BASE_SIT_URL",
        "PLAYWRIGHT_BASE_UAT_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "dev": {
      "persistent": true
    },
    "test:e2e": {
      "env": ["PLAYWRIGHT_ENV"],
      "outputs": []
    }
  }
}
