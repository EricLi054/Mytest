{
  "name": "@racwa/myrac",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm next dev",
    "format": "prettier --check . --ignore-path ./.prettierignore",
    "format:fix": "prettier --write . --ignore-path ./.prettierignore",
    "lint": "eslint",
    "start": "pnpm next start",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:local": "playwright test --headed --config=e2e",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "catalog:",
    "@contentful/rich-text-types": "catalog:",
    "@data-driven-forms/common": "^4.0.0",
    "@data-driven-forms/mui-component-mapper": "^4.0.0",
    "@data-driven-forms/react-form-renderer": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "catalog:",
    "@fortawesome/react-fontawesome": "catalog:",
    "@mui/material": "catalog:mui",
    "@mui/material-nextjs": "catalog:mui",
    "@next/third-parties": "catalog:next15",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@racwa/analytics": "catalog:",
    "@racwa/app-config": "workspace:*",
    "@racwa/auth": "workspace:*",
    "@racwa/cache": "workspace:*",
    "@racwa/gql": "workspace:*",
    "@racwa/mfa": "workspace:*",
    "@racwa/otel": "workspace:*",
    "@racwa/react-components": "catalog:",
    "@racwa/styles": "catalog:",
    "@racwa/ui": "workspace:*",
    "dotenv": "catalog:",
    "gql.tada": "catalog:",
    "jsbarcode": "^3.11.6",
    "next": "catalog:next15",
    "next-auth": "catalog:",
    "qrcode.react": "^4.2.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "server-only": "catalog:",
    "use-debounce": "^10.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@racwa/automation": "workspace:*",
    "@racwa/eslint-config": "workspace:*",
    "@racwa/playwright-config": "workspace:*",
    "@racwa/prettier-config": "workspace:*",
    "@racwa/tsconfig": "workspace:*",
    "@racwa/vitest-config": "workspace:*",
    "@storybook/react": "catalog:",
    "@storybook/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@racwa/prettier-config"
}
