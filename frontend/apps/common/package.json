    "zod": "catalog:"
  },
  "devDependencies": {
    "@racwa/eslint-config": "workspace:*",
    "@racwa/prettier-config": "workspace:*",
    "@racwa/tsconfig": "workspace:*",
    "@racwa/vitest-config": "workspace:*",
    "@storybook/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@racwa/prettier-config"
