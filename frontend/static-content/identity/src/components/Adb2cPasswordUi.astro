---
// ADB2C Password UI

// Scripts to uplift the experience provided by Microsoft
// to the RAC designed one.

// A `getPageDetails() => { url: string, title: string }` function should be
// defined by the consuming page to get analytics events sent.

import Reference from "./Reference.astro";
import chevronRight from "../../public/icons/chevron-right.svg";
import circleCheck from "../../public/icons/circle-check.svg";
import circleXMark from "../../public/icons/circle-x-mark.svg";
import eye from "../../public/icons/eye.svg";
import eyeSlash from "../../public/icons/eye-slash.svg";

interface Props {
  /** The title for the Password page */
  passwordPageTitle: string;
  /** The title for the Password tab */
  passwordTabTitle: string;
  /** The label for the Password field */
  passwordLabel: string;
  /** The label for the Continue button */
  passwordContinueLabel: string;
}

const {
  passwordPageTitle,
  passwordTabTitle,
  passwordLabel,
  passwordContinueLabel,
} = Astro.props as Props;
---

<>
  <Reference id="refPasswordPageTitle" value=`${passwordPageTitle}` />
  <Reference id="refPasswordTabTitle" value=`${passwordTabTitle}` />
  <Reference id="refPasswordLabel" value=`${passwordLabel}` />
  <Reference id="refPasswordContinueLabel" value=`${passwordContinueLabel}` />
  <Reference id="refChevronRight" value=`${chevronRight.src}` />
  <Reference id="refCircleCheck" value=`${circleCheck.src}` />
  <Reference id="refCircleXMark" value=`${circleXMark.src}` />
  <Reference id="refEye" value=`${eye.src}` />
  <Reference id="refEyeSlash" value=`${eyeSlash.src}` />
</>

<style is:inline>
  .icon {
    height: 16px;
    width: 16px;
  }

  .icon-container {
    display: inline-flex;
    align-items: center;
    width: 100%;
    gap: 10px;
    font-weight: 300;
    margin-bottom: 4px;

    &.icon-success {
      font-weight: 400;
      color: #3c763d;
    }

    &.icon-error {
      font-weight: 400;
      color: #a94442;
    }
  }

  #pwdInfo,
  .attrEntry:has(> #reenterPassword) {
    display: none;
  }

  #passwordContainer,
  #oldPasswordContainer {
    position: relative;
  }

  #togglePassword,
  #toggleOldPassword {
    height: 20px;
    width: 20px;
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
  }

  #verifying_modal,
  #verifying_blurb {
    display: none !important;
  }
</style>

<script is:inline>
  function sendPasswordGtmPageView() {
    if (typeof getPageDetails === "function") {
      sendGtmPageView(getPageDetails());
    }
  }

  function sendPasswordGtmFieldTouched(field) {
    if (typeof getPageDetails === "function") {
      sendGtmFieldTouched(field, getPageDetails());
    }
  }

  function sendPasswordGtmCustomEvent(description) {
    if (typeof getPageDetails === "function") {
      sendGtmCustomEvent(description, getPageDetails());
    }
  }

  var isChangePassword;
  var missingPasswordError;
  var missingOldPasswordError = $('.Password:first .error[role="alert"]');
  var passwordFieldGainedFocus = false;
  var passwordFieldLostFocus = false;
  var oldPasswordFieldGainedFocus = false;
  var oldPasswordFieldLostFocus = false;
  var passwordLength = "#passwordLength";
  var passwordUpper = "#passwordUpper";
  var passwordLower = "#passwordLower";
  var passwordNumber = "#passwordNumber";
  var passwordSpecial = "#passwordSpecial";
  var passwordDuplicates = "#passwordDuplicates";
  var enterPasswordSetInterval = setInterval(watchForEnterPassword, 90);
  var submitPasswordSetInterval, submitErrorsSetInterval;

  function setPasswordErrorState(hasError) {
    if (hasError) {
      $("#newPassword").addClass("formError");
      $("#newPassword_label").addClass("formError");
    } else {
      $("#newPassword").removeClass("formError");
      $("#newPassword_label").removeClass("formError");
    }
  }

  function setOldPasswordErrorState(hasError) {
    if (hasError) {
      $("#oldPassword").addClass("formError");
      $("#oldPassword_label").addClass("formError");
    } else {
      $("#oldPassword").removeClass("formError");
      $("#oldPassword_label").removeClass("formError");
    }
  }

  function watchForEnterPassword() {
    if (isElementVisible("#newPassword")) {
      $(pageTitle).text($("#refPasswordPageTitle").html());
      $("title").text($("#refPasswordTabTitle").html());
      sendPasswordGtmPageView();

      isChangePassword = $("#oldPassword").length == 1;
      missingPasswordError = $(
        `.Password:nth-of-type(${isChangePassword ? 2 : 1}) .error[role="alert"]`,
      );

      $("#emailAddress").hide();
      $("label[for=emailAddress]").hide();
      $("#continue").text($("#refPasswordContinueLabel").html());
      $("#verifying-modal").remove();
      setupPasswordField();
      performPasswordUxMods();

      if (isChangePassword) {
        setupOldPasswordField();
      }

      submitPasswordSetInterval = setInterval(watchForSubmitPassword, 50);
      clearInterval(enterPasswordSetInterval);
    }
  }

  function watchForSubmitPassword() {
    if ($("#simplemodal-overlay, #simplemodal-container").length > 0) {
      showLoadingModal("Submitting");
      submitErrorsSetInterval = setInterval(watchForSubmitErrors, 30);
      clearInterval(submitPasswordSetInterval);
    }
  }

  function watchForSubmitErrors() {
    if (isElementVisible("#claimVerificationServerError")) {
      hideLoadingModal();
      setOldPasswordErrorState(true);
      clearInterval(submitErrorsSetInterval);
    }
  }

  function validatePassword(wasSubmitClicked) {
    var newPassword = $("#newPassword").val();

    if (newPassword.length > 0) {
      missingPasswordError.hide();
    }

    var lengthValid = newPassword.length >= 8 && newPassword.length <= 30;
    var lowerValid = /[a-z]/.test(newPassword);
    var upperValid = /[A-Z]/.test(newPassword);
    var numberValid = /[0-9]/.test(newPassword);
    var specialValid = /[^A-Za-z0-9]/.test(newPassword);
    var duplicatesValid = hasNoConsecutiveDuplicates(newPassword);
    var allValid =
      lengthValid &&
      lowerValid &&
      upperValid &&
      numberValid &&
      specialValid &&
      duplicatesValid;

    setRequirementValid(passwordLength, lengthValid);
    setRequirementValid(passwordLower, lowerValid);
    setRequirementValid(passwordUpper, upperValid);
    setRequirementValid(passwordNumber, numberValid);
    setRequirementValid(passwordSpecial, specialValid);
    setRequirementValid(passwordDuplicates, duplicatesValid);

    setPasswordErrorState(passwordFieldLostFocus && !allValid);
    $("#reenterPassword").val(allValid ? newPassword : "");

    if (wasSubmitClicked) {
      if (allValid) {
        sendPasswordGtmCustomEvent("Password rules met");
        sendPasswordGtmCustomEvent("myRAC password reset success");
      } else {
        sendPasswordGtmCustomEvent("Password rules not met error validation");
      }
    }
  }

  function validateOldPassword() {
    var oldPassword = $("#oldPassword").val();

    if (oldPassword.length > 0) {
      missingOldPasswordError.hide();
      setOldPasswordErrorState(false);
    } else if (passwordFieldLostFocus && oldPassword.length === 0) {
      missingOldPasswordError.show();
      setOldPasswordErrorState(true);
    }
  }

  function setupPasswordField() {
    missingPasswordError.html("This field is required");

    $("#newPassword").on("input", function () {
      validatePassword();
    });

    $("#newPassword").on("focus", function () {
      passwordFieldGainedFocus = true;
    });

    $("#newPassword").on("blur", function () {
      sendPasswordGtmFieldTouched("Password");
    });

    $(document).on("click", function (event) {
      var elementClicked = event.target.id;
      var clickedOutsidePasswordField =
        elementClicked !== "newPassword" && elementClicked !== "togglePassword";
      var submitClicked = elementClicked === "continue";

      var shouldTriggerMissingPassword =
        (clickedOutsidePasswordField && passwordFieldLostFocus) ||
        submitClicked;

      if (
        shouldTriggerMissingPassword &&
        $("#newPassword").val().length === 0
      ) {
        sendPasswordGtmCustomEvent("Password nothing entered error validation");
        missingPasswordError.show();
        setPasswordErrorState(true);
      }

      // Trigger the error state if the password field has gained then lost focus, or if
      // the submit button is clicked
      if (
        (passwordFieldGainedFocus && clickedOutsidePasswordField) ||
        submitClicked
      ) {
        passwordFieldLostFocus = true;
        validatePassword(submitClicked);
      }
    });
  }

  function setupOldPasswordField() {
    missingOldPasswordError.html("This field is required");
    missingOldPasswordError.insertAfter("#oldPassword");
    $("#claimVerificationServerError").insertAfter("#oldPassword");
    $(".attrEntry:first").css("margin-bottom", "16px");
    $("#oldPassword_label").html("Current password");
    $("#oldPassword").attr("placeholder", "Enter current password");

    $("#oldPassword")
      .wrap("<div id='oldPasswordContainer'></div>")
      .after(
        `<img id="toggleOldPassword" class="icon" src="${$("#refEye").text()}" />`,
      );

    $("#toggleOldPassword").on("click", function () {
      var input = $("#oldPassword");
      var icon = $("#toggleOldPassword");
      var eye = $("#refEye").text();
      var eyeSlash = $("#refEyeSlash").text();

      if (input.attr("type") === "password") {
        sendPasswordGtmCustomEvent("Current password visible");
        icon.attr("src", eyeSlash);
        input.attr("type", "text");
      } else {
        sendPasswordGtmCustomEvent("Current password hidden");
        icon.attr("src", eye);
        input.attr("type", "password");
      }
    });

    $("#oldPassword").on("input", function () {
      $("#claimVerificationServerError").hide();
      validateOldPassword();
    });

    $("#oldPassword").on("focus", function () {
      oldPasswordFieldGainedFocus = true;
    });

    $("#oldPassword").on("blur", function () {
      sendPasswordGtmFieldTouched("Current password");
    });

    $(document).on("click", function (event) {
      var elementClicked = event.target.id;
      var clickedOutsideOldPasswordField =
        elementClicked !== "oldPassword" &&
        elementClicked !== "toggleOldPassword";
      var submitClicked = elementClicked === "continue";

      var shouldTriggerMissingOldPassword =
        (clickedOutsideOldPasswordField && oldPasswordFieldLostFocus) ||
        submitClicked;

      if (
        shouldTriggerMissingOldPassword &&
        $("#oldPassword").val().length === 0
      ) {
        sendPasswordGtmCustomEvent(
          "Current password nothing entered error validation",
        );
        missingOldPasswordError.show();
        setOldPasswordErrorState(true);
      }

      // Trigger the error state if the password field has gained then lost focus, or if
      // the submit button is clicked
      if (
        (oldPasswordFieldGainedFocus && clickedOutsideOldPasswordField) ||
        submitClicked
      ) {
        oldPasswordFieldLostFocus = true;
        validateOldPassword();
      }
    });
  }

  function hasNoConsecutiveDuplicates(str) {
    // For a consistent appearance, fail this rule
    // if the string is empty.
    if (str.length === 0) {
      return false;
    }

    for (let i = 1; i < str.length; i++) {
      if (str[i] === str[i - 1]) {
        return false;
      }
    }

    return true;
  }
  function sendEmailGtmCustomEvent(description) {
    if (typeof getPageDetails === "function") {
      sendGtmCustomEvent(description, getPageDetails());
    }
  }

  function replacePasswordCancelButton() {
    const racHomePageUrl = $("#refRacHomePage").html();
    $("<a id='cancel-link'>Cancel</a>").insertAfter("#cancel");
    $("#cancel").remove();

    $("#cancel-link").on("click", function () {
      sendEmailGtmCustomEvent("Cancel");
      window.location.href = racHomePageUrl;
    });
  }

  function performPasswordUxMods() {
    $(".error.itemLevel").css({
      display: "none",
    });

    $(".intro").css({
      display: "none",
    });

    $(
      "<style>#requiredFieldMissing { display: none !important; }</style>",
    ).appendTo("head");

    replacePasswordCancelButton();
    $("#continue").css("margin-bottom", "16px");

    var email = $("#emailAddress").val();
    if (email) {
      $(pageTitle).after(`<p id="pageSubtitle">${email}</p>`);
    }

    var $alertLbTou = $("#extension_TermsOfUse_True").prev(".error");
    $alertLbTou.insertAfter($alertLbTou.parent().find("#tou"));

    var $alertLbl = $("#newPassword").prev(".itemLevel");
    $alertLbl.insertAfter($alertLbl.parent().find("#newPassword"));
    $("#newPassword_label").text($("#refPasswordLabel").html());
    $("#newPassword").attr("placeholder", "Enter new password");
    $("#newPassword")
      .wrap("<div id='passwordContainer'></div>")
      .after(
        `<img id="togglePassword" class="icon" src="${$("#refEye").text()}" />`,
      );

    $("#togglePassword").on("click", function () {
      var input = $("#newPassword");
      var icon = $("#togglePassword");
      var eye = $("#refEye").text();
      var eyeSlash = $("#refEyeSlash").text();

      if (input.attr("type") === "password") {
        sendPasswordGtmCustomEvent("Password visible");
        icon.attr("src", eyeSlash);
        input.attr("type", "text");
      } else {
        sendPasswordGtmCustomEvent("Password hidden");
        icon.attr("src", eye);
        input.attr("type", "password");
      }
    });

    $("#attributeList").after(
      createPasswordRequirement(
        "passwordDuplicates",
        "Max two consecutive identical characters",
      ),
    );
    $("#attributeList").after(
      createPasswordRequirement(
        "passwordSpecial",
        "A special character (e.g. !, @, #)",
      ),
    );
    $("#attributeList").after(
      createPasswordRequirement("passwordNumber", "A number"),
    );
    $("#attributeList").after(
      createPasswordRequirement("passwordLower", "A lowercase letter"),
    );
    $("#attributeList").after(
      createPasswordRequirement("passwordUpper", "An uppercase letter"),
    );
    $("#attributeList").after(
      createPasswordRequirement("passwordLength", "8 to 30 characters"),
    );
  }

  function setRequirementValid(id, isValid) {
    var row = $(id);
    var icon = row.find(".icon");
    row.removeClass("icon-success icon-error");

    if (isValid) {
      $(id).addClass("icon-success");
      icon.attr("src", $("#refCircleCheck").text());
    } else if (passwordFieldLostFocus) {
      $(id).addClass("icon-error");
      icon.attr("src", $("#refCircleXMark").text());
    } else {
      icon.attr("src", $("#refChevronRight").text());
    }
  }

  function createPasswordRequirement(id, text) {
    return $(`
        <div class="icon-container" id="${id}">
          <img class="icon" src="${$("#refChevronRight").text()}" />
          ${text}
        </div>
      `);
  }
</script>
