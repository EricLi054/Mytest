---
//  Reference

//  When importing strings (such as an image src or environment variable)
//  in an Astro template you can only utilise it in the HTML section and
//  not in the Javascript. This component stores the string in the HTML tree
//  so that it can be looked up and used in scripts.

interface Props {
  id: string;
  value: string;
}

const { id, value } = Astro.props as Props;
---

<span id={id} style="display: none;">{value}</span>
