---
import Adb2CContent from "../components/Adb2cContent.astro";
import RacLogo from "../components/RacLogo.astro";
import Layout from "../layouts/Layout.astro";
import Adb2CPasswordUi from "../components/Adb2cPasswordUi.astro";
import Adb2CConfirmationUi from "../components/Adb2cConfirmationUi.astro";
---

<Layout title="Change your password | myRAC registration">
  <main>
    <RacLogo />
    <h1 id="pageTitle">Choose a password</h1>
    <div id="content-box">
      <Adb2CContent />
    </div>
    <Adb2CPasswordUi
      passwordPageTitle="Choose a password"
      passwordTabTitle="Change your password | myRAC registration"
      passwordLabel="Create new password"
      passwordContinueLabel="Reset password"
    />
    <Adb2CConfirmationUi confirmationContinueLabel="Back to myRAC" />
  </main>

  <script is:inline>
    function getPageDetails() {
      var title = document.title;
      var url = "";

      switch (title) {
        case "Change your password | myRAC registration":
          url = "/identify/change-password/password";
          break;
        case "Confirmation | myRAC registration":
          url = "/identify/change-password/confirmation";
          break;
      }

      return { url, title };
    }
  </script>
</Layout>
