---
import Adb2CContent from "../components/Adb2cContent.astro";
import Adb2CEmailOtpUi from "../components/Adb2cEmailOtpUi.astro";
import Adb2CPasswordUi from "../components/Adb2cPasswordUi.astro";
import RacLogo from "../components/RacLogo.astro";
import Reference from "../components/Reference.astro";
import Layout from "../layouts/Layout.astro";
import NotificationCard from "../components/NotificationCard.astro";
import EmailAlreadyLinkedError from "../components/EmailAlreadyLinkedError.astro";
import EmailDoesNotExistError from "../components/EmailDoesNotExistError.astro";
import Adb2CConfirmationUi from "../components/Adb2cConfirmationUi.astro";
---

<Layout title="Enter your login email | myRAC registration">
  <main>
    <RacLogo />
    <h1 id="pageTitle">Choose a password</h1>
    <div id="content-box">
      <Adb2CContent />
    </div>
    <EmailDoesNotExistError />
    <EmailAlreadyLinkedError />
    <NotificationCard
      id="alertCodeExpiry"
      message="This code expires in five minutes. You may need to check your spam folder."
    />
    <Adb2CEmailOtpUi
      verificationControlId="emailVerificationControlPasswordReset"
      emailPageTitle="Choose a password"
      emailTabTitle="Enter your login email | myRAC registration"
      verifyEmailPageTitle="Choose a password"
      verifyEmailTabTitle="Verify your login email | myRAC registration"
    />
    <Adb2CPasswordUi
      passwordPageTitle="Choose a password"
      passwordTabTitle="Choose a password | myRAC registration"
      passwordLabel="Create new password"
      passwordContinueLabel="Reset password"
    />
    <Adb2CConfirmationUi confirmationContinueLabel="Log in" />
  </main>

  <script is:inline>
    function getPageDetails() {
      var title = document.title;
      var url = "";

      switch (title) {
        case "Enter your login email | myRAC registration":
          url = "/identify/password-reset/email";
          break;
        case "Verify your login email | myRAC registration":
          url = "/identify/password-reset/verify-email";
          break;
        case "Choose a password | myRAC registration":
          url = "/identify/password-reset/password";
          break;
        case "Confirmation | myRAC registration":
          url = "/identify/password-reset/confirmation";
          break;
      }

      return { url, title };
    }
  </script>
</Layout>
