{
  "name": "@racwa/mfa",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "clean": "git clean -xdf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../../.gitignore",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@conform-to/react": "catalog:",
    "@conform-to/zod": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/icons-material": "catalog:mui",
    "@mui/material": "catalog:mui",
    "@mui/system": "catalog:mui",
    "@racwa/analytics": "catalog:",
    "@racwa/react-components": "catalog:",
    "@racwa/styles": "catalog:",
    "react": "catalog:react19",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@racwa/eslint-config": "workspace:*",
    "@racwa/prettier-config": "workspace:*",
    "@racwa/tsconfig": "workspace:*",
    "@racwa/vitest-config": "workspace:*",
    "@storybook/blocks": "catalog:",
    "@storybook/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@racwa/prettier-config"
}
